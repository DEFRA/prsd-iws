@model EA.Iws.Web.Areas.Admin.ViewModels.Menu.ReportLinkViewModel

@{
    var reportLinks = new[]
    {
        new { Text = "Export stats", Controller = "ExportStats" },
        new { Text = "Import stats", Controller = "ImportStats" },
        new { Text = "Shipments report", Controller = "Shipments" },
        new { Text = "Data export notifications", Controller = "ExportNotifications" },
        new { Text = "Data import notifications", Controller = "ImportNotifications" },
        new { Text = "Finance report", Controller = "Finance" },
        new { Text = "Producer report", Controller = "Producer" },
        new { Text = "FOI report", Controller = "FreedomOfInformation" },
        new { Text = "Export movement documents input", Controller = "ExportMovements" },
        new { Text = "Compliance report", Controller = "Compliance" },
        new { Text = "Financial guarantees", Controller = "FinancialGuarantees" }
    };
}

<ul>
    @foreach (var link in reportLinks)
    {
        <li>
            @Html.ActionLink(link.Text, "Index", link.Controller, new { area = "Reports" }, null)
        </li>
    }

    @if (Model.ShowEAReportLinks)
    {
        <li>
            @Html.ActionLink("Download EA reports data", "Index", "EADataReports", new { area = "Reports" }, null)
        </li>
    }
</ul>
