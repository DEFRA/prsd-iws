@model EA.Iws.Web.Areas.NotificationApplication.ViewModels.WhatToDoNext.PaymentResultViewModel

@{
    ViewBag.Title = "Your payment has failed";
    Layout = "~/Views/Shared/_Layout.GovUK.Sections.cshtml";
}

<div class="grid-row">
    <div class="column-two-thirds">

        <header class="hgroup">
            <h1 class="govuk-heading-l">Payment not successful</h1>
        </header>

        <p class="govuk-body">
            Your payment has failed. You can either retry your payment or contact us at @Html.IwsContactEmail().
        </p>

        @using (Html.BeginForm("PayOnline", "WhatToDoNext", new { id = Model.NotificationId, area = "NotificationApplication" }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="govuk-button-group govuk-!-padding-top-3">
                <button type="submit" class="govuk-button">Retry payment</button>
            </div>
        }

        <p class="govuk-body">
            @Html.ActionLink("Return to notification charges and payment information", "Payment", "WhatToDoNext", new { id = Model.NotificationId, area = "NotificationApplication" }, new { @class = "govuk-link" })
        </p>

    </div>
</div>